{
  "name": "benchmarkblock-react",
  "version": "1.0.0",
  "description": "Бенчмарк доступа к заблокированным сайтам (РФ) — Electron + React",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "selftest": "node scripts/selftest.mjs",
    "uicheck": "node scripts/uicheck.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dist": "electron-vite build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "ru.benchmarkblock.app",
    "productName": "BenchmarkBlock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config/sites.json",
        "to": "config/sites.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BenchmarkBlock",
      "runAfterFinish": true
    }
  }
}
